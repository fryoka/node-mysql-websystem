<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css">
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
</head>
<body>
<%- include('./header'); %>
<%- include('./error_messages'); %>

<% if(isAuth) { %>
<div class="container">
  <div class="row">
    <div class="col-md-6">
      <form action="/" method="post">
        <label>タスクの追加</label>
        <input required type="text" name="add" placeholder="何をする?" />
        <input type="date" name="due_date" required />
        <input type="submit" value="追加" />
      </form>
    </div>
  </div>
</div>

<div class="container mt-4">
  <div id="calendar"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');
    const calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      locale: 'ja',
      events: [
        <% todos.forEach(function(todo) { 
             const date = new Date(todo.due_date);
             if (todo.due_date && !isNaN(date)) { %>
          {
            id: "<%= todo.id %>",
            title: "<%= todo.content %>",
            start: "<%= date.toISOString().slice(0, 10) %>"
          },
        <% } }); %>
      ],
      eventClick: function(info) {
        if (confirm(`「${info.event.title}」を削除しますか？`)) {
          fetch(`/delete/${info.event.id}`, {
            method: 'POST'
          })
          .then(() => {
            info.event.remove();
          })
          .catch(err => {
            alert('削除に失敗しました');
            console.error(err);
          });
        }
      }
    });
    calendar.render();
  });
</script>

<% } else { %>
  <h1>Welcome to the TodoApp</h1>
  <a class="btn btn-primary" href="/signup" role="button">Sign up now!</a>
<% } %>

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/js/bootstrap.min.js"></script>
</body>
</html>
